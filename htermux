#!/bin/sh
# ============================================================
# htermux — RLight Huawei B715 one-shot (Termux + adb shell)
# ============================================================
# Semua kerja dalam adb shell modem. Termux hanya untuk push busybox.
#
# Guna dalam Termux:
#   pkg install android-tools wget
#   sh htermux
#
# ============================================================

set -eu

REPO="Razifadm/radu"
BRANCH="h7one"
ADB_HOST="192.168.8.1:5555"
MODEM_IP="192.168.8.1"

say()  { printf '[*] %s\n' "$*"; }
ok()   { printf '[✓] %s\n' "$*"; }
fail() { printf '[✗] %s\n' "$*" >&2; exit 1; }

for t in adb wget; do
    command -v "$t" >/dev/null 2>&1 || fail "Install: pkg install android-tools wget"
done

WORK=$(mktemp -d "$HOME/.rlight-htermux.XXXXXX")
trap 'rm -rf "$WORK"' EXIT

# 1. Download busybox standard (Termux)
say "Download busybox..."
wget -q -O "$WORK/busybox" \
    "https://raw.githubusercontent.com/$REPO/ipk/busybox" \
    || fail "Download busybox gagal"
chmod 755 "$WORK/busybox"
ok "busybox downloaded"

# 2. ADB connect
say "ADB connect..."
adb connect "$ADB_HOST" >/dev/null 2>&1
sleep 2
adb devices 2>/dev/null | grep -q "$ADB_HOST" \
    || fail "ADB tak connect"
ok "ADB connected"

# 3. Push busybox ke modem
say "Push busybox..."
adb push "$WORK/busybox" /online/busybox >/dev/null 2>&1 \
    || fail "Push busybox gagal"
ok "busybox pushed"

# 4. Dalam modem: chmod + download rrrh + run
say "Setup dalam modem..."
adb shell '
    chmod 755 /online/busybox
    /online/busybox wget --no-check-certificate \
        --header="Host: raw.githubusercontent.com" \
        -O /online/rrrh \
        https://185.199.110.133/Razifadm/radu/h7one/rrrh
    chmod 755 /online/rrrh
'

ok "Menjalankan rrrh..."
adb shell 'rm -rf /online/.rlight-install.lock /online/data/.rlight-install.lock /online/.rlight-download.* 2>/dev/null'
echo "=========================================="
adb shell '/online/rrrh'
echo "=========================================="
ok "Selesai. Portal 8044: http://$MODEM_IP:8044"
