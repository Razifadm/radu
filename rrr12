#!/bin/sh
# RLight v4.22-r1 Embedded installer (ARM64 / OpenWrt / BusyBox ash).
# Patch r2: avoid nounset failure in fail(); show safe phase diagnostics.
# Xray Core is compiled into the RLight binary: no separate xray executable.
# Archive must contain an ARM64 executable named "rlight" (nested folders OK).
# Requires an embedded-aware RLight activation-web command that does not
# require --xray and installs/launches the built-in Xray runtime.
# The bootstrap does not alter the core, manifest, firewall, boot or licence.
# Optional overrides: RLIGHT_VERSION, RLIGHT_ARCHIVE_URL, RLIGHT_LAN_IP,
# RLIGHT_INSTALL_ROOT, RLIGHT_ACTIVATION_PORT.
set +x
set -eu
umask 077
# ===== EDIT THESE TWO VALUES WHEN PUBLISHING A NEW RELEASE =====
EXPECTED_VERSION=${RLIGHT_VERSION:-xSorlax-4}
ARCHIVE_URL=${RLIGHT_ARCHIVE_URL:-https://raw.githubusercontent.com/Razifadm/radu/ipk/r4}
# ===========================================================
PORT=${RLIGHT_ACTIVATION_PORT:-8044}
WORK=''
PORTAL_PID=''
STAGE='initialization'
# Always tolerate zero arguments: ash + "set -u" otherwise throws
# "line N: 1: parameter not set" and hides the real installer error.
fail() {
 message=${1:-"Installation stopped during $STAGE."}
 printf 'RLight: %s\n' "$message" >&2
 exit 1
}

cleanup() {
 if [ -n "$PORTAL_PID" ]; then kill "$PORTAL_PID" 2>/dev/null || :; wait "$PORTAL_PID" 2>/dev/null || :; fi
 if [ -n "$WORK" ]; then rm -rf -- "$WORK"; fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
STAGE='router compatibility checks'
[ "$(id -u)" = 0 ] || fail 'Run as root on the router.'
case "$PORT" in ''|*[!0-9]*) fail 'Invalid activation port.' ;; esac
[ "$PORT" -ge 1 ] && [ "$PORT" -le 65535 ] || fail 'Activation port must be 1..65535.'
case "$(uname -m)" in
 aarch64|arm64) CORE_NAME=rlight ;;
 *) fail 'This bootstrap supports ARM64 only.' ;;
esac
private_ipv4() {
 printf '%s\n' "${1:-}" | awk -F. '
 NF!=4 {exit 1}
 {for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || length($i)>3 || $i+0>255) exit 1;
 if($1==10 || ($1==172 && $2>=16 && $2<=31) || ($1==192 && $2==168)) exit 0; exit 1}'
}
LAN=${RLIGHT_LAN_IP:-}
if [ -z "$LAN" ] && command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
 LAN=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null) || LAN=''
fi
if [ -z "$LAN" ] && command -v ip >/dev/null 2>&1; then
 LAN=$(ip -4 -o addr show dev br-lan 2>/dev/null | awk '{split($4,a,"/");print a[1];exit}') || LAN=''
fi
if [ -z "$LAN" ] && command -v uci >/dev/null 2>&1; then
 LAN=$(uci -q get network.lan.ipaddr 2>/dev/null) || LAN=''
 LAN=${LAN%%/*}
fi
private_ipv4 "$LAN" || fail 'Cannot detect a private LAN IPv4. Set RLIGHT_LAN_IP to the router LAN address.'
STAGE='creating temporary workspace'
WORK=$(mktemp -d /tmp/rlight-activation.XXXXXX) || fail 'Cannot create temporary workspace.'
fetch() {
 [ "$#" -eq 2 ] || fail "Internal fetch error during $STAGE."
 case "$1" in https://*) ;; *) fail 'Downloads require HTTPS.' ;; esac
 if command -v curl >/dev/null 2>&1; then
  curl --fail --location --silent --show-error --proto '=https' --proto-redir '=https' --connect-timeout 20 --max-time 300 --output "$2" "$1" >/dev/null 2>&1 || fail 'Download failed. Check the configured URL, network and CA certificates.'
 elif command -v wget >/dev/null 2>&1; then
  wget -T 60 -O "$2" "$1" >/dev/null 2>&1 || fail 'Download failed. Check the configured URL, network and CA certificates.'
 else fail 'curl or wget is required.'; fi
 [ -s "$2" ] || fail 'Downloaded file is empty.'
}
STAGE='loading archive extraction tool'
UNZIP=$(command -v unzip 2>/dev/null || :)
if [ -z "$UNZIP" ]; then
 printf '%s\n' 'Loading 1...'
 UNZIP=$WORK/rlight-unzip-aarch64
 fetch 'https://raw.githubusercontent.com/Razifadm/radu/main/usr/bin/rlight-deps/aarch64/rlight-unzip-aarch64' "$UNZIP"
 chmod 700 "$UNZIP"
fi
STAGE='downloading RLight archive'
printf '%s\n' 'Loading 2..'
fetch "$ARCHIVE_URL" "$WORK/rlight.zip"
# Read members through stdout, never unpack archive paths onto the filesystem.
# This avoids path traversal/symlink writes even with a malformed package.
STAGE='reading RLight archive'
if LC_ALL=C "$UNZIP" -Z1 "$WORK/rlight.zip" > "$WORK/members" 2>/dev/null; then
 :
else
 LC_ALL=C "$UNZIP" -l "$WORK/rlight.zip" > "$WORK/zip-list" 2>/dev/null || fail 'Cannot read ZIP. Check the archive and unzip helper compatibility.'
 awk 'NF==4 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9-]+$/ && $3 ~ /^[0-9:]+$/ {print $4}' "$WORK/zip-list" > "$WORK/members"
fi
[ -s "$WORK/members" ] || fail 'ZIP has no supported file entries. Use simple filenames without spaces.'
select_member() {
 [ "$#" -eq 2 ] || fail "Internal archive selection error during $STAGE."
 # Prefer the architecture-specific name, then a single generic binary.
 for wanted in "$1" "$2"; do
  matches=$(awk -F/ -v wanted="$wanted" '$NF==wanted {print}' "$WORK/members")
  count=$(printf '%s\n' "$matches" | awk 'NF {n++} END {print n+0}')
  [ "$count" -le 1 ] || fail 'ZIP has duplicate binary names. Include one binary per architecture.'
  if [ "$count" = 1 ]; then
   case "$matches" in /*|../*|*/../*|*/..|*\\*|*\**|*\?*|*\[*|*\]*) fail 'Unsafe ZIP member name.' ;; esac
   printf '%s' "$matches"; return 0
  fi
 done
 return 1
}
STAGE='extracting embedded RLight binary'
CORE_MEMBER=$(select_member "$CORE_NAME" rlight) || fail 'Cannot select rlight in ZIP. Include a compiled rlight binary, not source code.'
"$UNZIP" -p "$WORK/rlight.zip" "$CORE_MEMBER" > "$WORK/rlight" 2>/dev/null || fail 'Cannot extract RLight binary.'
chmod 700 "$WORK/rlight"
STAGE='checking RLight binary compatibility'
version=$("$WORK/rlight" version 2>/dev/null) || fail 'Core cannot execute on this router.'
case "$version" in
 *"v$EXPECTED_VERSION "*|*"v$EXPECTED_VERSION"|*"v$EXPECTED_VERSION-"* ) ;;
 *) fail "Core version mismatch. Expected v$EXPECTED_VERSION." ;;
esac
unset version
# Capture encryption output in shell memory. No request temp file or syslog.
STAGE='generating activation request'
REQUEST=$("$WORK/rlight" activation-request 2>/dev/null) || fail 'Cannot generate activation request. Check device identity and the core public key.'
case "$REQUEST" in RLREQ1-*) ;; *) fail 'Unexpected activation response.' ;; esac
# Sensitive output goes only to a controlling terminal, not redirected stdout.
if ( : >/dev/tty ) 2>/dev/null; then
 { printf '\n%s\n' 'Send This to https://t.me/Raducksijaa     :'; printf '%s\n\n' "$REQUEST"; } >/dev/tty
else
 printf '%s\n' 'No controlling terminal. Use Generate Activation Request in the WebUI to copy a request.'
fi
unset REQUEST
# Embedded: activation-web installs the RLight binary alone.
# IMPORTANT: the embedded RLight implementation must accept no --xray flag.
STAGE='starting embedded activation WebUI'
set -- activation-web --listen "$LAN:$PORT"
if [ -n "${RLIGHT_INSTALL_ROOT:-}" ]; then
 case "$RLIGHT_INSTALL_ROOT" in /*) ;; *) fail 'RLIGHT_INSTALL_ROOT must be absolute.' ;; esac
 set -- "$@" --root "$RLIGHT_INSTALL_ROOT"
fi
"$WORK/rlight" "$@" >/dev/null 2>&1 &
PORTAL_PID=$!
sleep 1
kill -0 "$PORTAL_PID" 2>/dev/null || fail 'Activation server failed to start. Check the LAN IP or whether the port is already in use.'
printf '\nRLight Activation: http://%s:%s\n' "$LAN" "$PORT"
printf '%s\n' 'Open this address, enter the code supplied by Raducksijaa, then select Activate and Install.' 'Keep this terminal open until installation completes.'
if wait "$PORTAL_PID"; then PORTAL_PID='';else PORTAL_PID='';fail 'Activation server stopped.';fi
